# ─────────────────────────────────────────────────────────────────────────────
# PyFlare Environment Configuration Template
# Copy this file to .env and supply your local or production credentials.
# NEVER commit real credentials, tokens, or private URLs into version control.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server & Network Security ---
PYFLARE_HOST=127.0.0.1
PYFLARE_PORT=8000
PYFLARE_ALLOW_EXTERNAL_BIND=false
PYFLARE_LOG_LEVEL=INFO

# --- API Authentication ---
# Set an API key to protect sensitive endpoints (/jobs, /run, /plan, /memory, /providers, /deploy).
# When unset, PyFlare operates in unauthenticated local development mode.
PYFLARE_API_KEY=your_secure_random_api_key_here
PYFLARE_REQUIRE_AUTH=true

# --- Workspace & Storage Paths ---
PYFLARE_WORKSPACE_DIR=./workspace
PYFLARE_OUTPUT_DIR=./output
PYFLARE_DATABASE_PATH=./data/pyflare.db

# --- LLM Providers (Optional - local fallback used if not configured) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=

# --- Optional Integrations & Binaries ---
GODOT_BIN=godot
BLENDER_BIN=blender
FFMPEG_BIN=ffmpeg

# --- Deployment Worker (FTP disabled by default) ---
PYFLARE_FTP_ENABLED=false
PYFLARE_FTP_HOST=
PYFLARE_FTP_USER=
PYFLARE_FTP_PASS=
PYFLARE_FTP_REMOTE_DIR=/htdocs/builds
PYFLARE_WEB_BASE_URL=
