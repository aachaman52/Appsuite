[Desktop Entry]
Version=1.5
Type=Application
Name=PyFlare Settings
Comment=System configuration and preferences
GenericName=Settings
Icon=dev.pyflare.Settings
Exec=/opt/pyflare/bin/pyflare-settings
Terminal=false
StartupNotify=true
StartupWMClass=dev.pyflare.Settings
Categories=Settings;PyFlare;
Keywords=pyflare;settings;preferences;system;
X-GNOME-UsesNotifications=true
