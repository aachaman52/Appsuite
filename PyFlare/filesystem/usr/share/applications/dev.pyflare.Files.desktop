[Desktop Entry]
Version=1.5
Type=Application
Name=PyFlare Files
Comment=System file manager
GenericName=File Manager
Icon=dev.pyflare.Files
Exec=/opt/pyflare/bin/pyflare-files %U
Terminal=false
StartupNotify=true
StartupWMClass=dev.pyflare.Files
Categories=System;FileManager;PyFlare;
Keywords=pyflare;files;folders;explorer;
X-GNOME-UsesNotifications=true
