[Desktop Entry]
Version=1.5
Type=Application
Name=PyFlare Terminal
Comment=GPU-accelerated terminal
GenericName=Terminal
Icon=dev.pyflare.Terminal
Exec=/opt/pyflare/bin/pyflare-terminal
Terminal=false
StartupNotify=true
StartupWMClass=dev.pyflare.Terminal
Categories=System;TerminalEmulator;PyFlare;
Keywords=pyflare;terminal;console;shell;
X-GNOME-UsesNotifications=true
