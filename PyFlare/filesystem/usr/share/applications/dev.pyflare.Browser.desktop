[Desktop Entry]
Version=1.5
Type=Application
Name=PyFlare Browser
Comment=Privacy-focused web browser
GenericName=Web Browser
Icon=dev.pyflare.Browser
Exec=/opt/pyflare/bin/pyflare-browser %u
Terminal=false
StartupNotify=true
StartupWMClass=dev.pyflare.Browser
Categories=Network;WebBrowser;PyFlare;
Keywords=pyflare;browser;web;internet;
X-GNOME-UsesNotifications=true
