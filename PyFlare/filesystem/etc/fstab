# /etc/fstab: static file system information
# PyFlare OS — generated by installer (Calamares)
#
# <file system>  <mount point>  <type>  <options>              <dump>  <pass>
# Root filesystem (replaced by Calamares at install time)
# LABEL=pyflare-root  /       ext4    errors=remount-ro       0       1
# LABEL=pyflare-efi   /boot/efi vfat  umask=0077              0       1
# LABEL=pyflare-swap  none    swap    sw                       0       0

# Pseudo-filesystems
proc            /proc       proc    nodev,noexec,nosuid     0       0
sysfs           /sys        sysfs   nodev,noexec,nosuid     0       0
devpts          /dev/pts    devpts  nodev,nosuid            0       0
tmpfs           /tmp        tmpfs   nosuid,nodev,size=2G    0       0
tmpfs           /run        tmpfs   nodev,nosuid,mode=0755  0       0
