# PyFlare OS sudoers override
# /etc/sudoers.d/pyflare
# Grant pyflare user full sudo access

# Full sudo access for main user
pyflare ALL=(ALL:ALL) ALL

# Allow passwordless update and package management commands
pyflare ALL=(ALL) NOPASSWD: /usr/bin/apt-get update, /usr/bin/apt-get upgrade -y
pyflare ALL=(ALL) NOPASSWD: /opt/pyflare/bin/pyflare-updater
pyflare ALL=(ALL) NOPASSWD: /bin/systemctl restart pyflare-engine
pyflare ALL=(ALL) NOPASSWD: /bin/systemctl start pyflare-engine
pyflare ALL=(ALL) NOPASSWD: /bin/systemctl stop pyflare-engine
