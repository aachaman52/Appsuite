[Unit]
Description=PyFlare Engine Background Service
After=network.target dbus.service
Wants=network.target

[Service]
Type=simple
ExecStart=/opt/pyflare/engine/pyflare-engine --daemon
ExecReload=/bin/kill -HUP $MAINPID
RemainAfterExit=yes
Restart=on-failure
RestartSec=10
StartLimitBurst=3
StartLimitIntervalSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pyflare-engine
Environment=PYFLARE_HOME=/opt/pyflare
Environment=PYFLARE_DATA=/var/lib/pyflare

[Install]
WantedBy=multi-user.target
