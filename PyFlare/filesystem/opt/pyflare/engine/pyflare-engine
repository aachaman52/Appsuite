#!/usr/bin/env python3
"""PyFlare Engine background service daemon."""
import os
import signal
import sys
import time

def handle_signal(sig, frame):
    sys.exit(0)

signal.signal(signal.SIGTERM, handle_signal)
signal.signal(signal.SIGINT, handle_signal)

sys.path.insert(0, '/opt/pyflare/lib')
print("PyFlare Engine 1.0.0 — background service started.")
sys.stdout.flush()

# Keep daemon running and responsive to signals
while True:
    time.sleep(3600)
