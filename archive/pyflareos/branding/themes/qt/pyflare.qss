/* PyFlare Qt/PySide6 Stylesheet */
/* Auto-generated by PyFlare Branding Generator */

QWidget {
  background-color: #0B0F19;
  color: #F9FAFB;
  font-family: "Inter", sans-serif;
  font-size: 15px;
}

QMainWindow, QDialog {
  background-color: #0B0F19;
}

QFrame {
  background-color: #111827;
  border: 1px solid #1F2937;
  border-radius: 8px;
}

QPushButton {
  background-color: #111827;
  border: 1px solid #1F2937;
  border-radius: 8px;
  padding: 6px 16px;
  color: #F9FAFB;
}

QPushButton:hover {
  background-color: #1F2937;
  border-color: #3B82F6;
}

QPushButton:pressed {
  background-color: #374151;
}

QPushButton#primaryButton {
  background-color: #3B82F6;
  border: none;
  color: white;
  font-weight: 600;
}

QLineEdit, QTextEdit, QPlainTextEdit {
  background-color: #111827;
  border: 1px solid #1F2937;
  border-radius: 8px;
  padding: 6px 10px;
  color: #F9FAFB;
  selection-background-color: #3B82F6;
}

QLineEdit:focus {
  border-color: #3B82F6;
}

QListWidget, QTreeWidget, QTableWidget {
  background-color: #111827;
  alternate-background-color: #1F2937;
  border: 1px solid #1F2937;
  border-radius: 8px;
}

QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
  background-color: #1E3A5F;
  color: #F9FAFB;
}

QScrollBar:vertical {
  width: 8px;
  background: #111827;
  border-radius: 4px;
}

QScrollBar::handle:vertical {
  background: #1F2937;
  border-radius: 4px;
  min-height: 24px;
}

QScrollBar::handle:vertical:hover {
  background: #3B82F6;
}

QProgressBar {
  background-color: #1F2937;
  border-radius: 9999px;
  height: 8px;
  text-align: center;
}

QProgressBar::chunk {
  background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
    stop:0 #3B82F6, stop:1 #00D4FF);
  border-radius: 9999px;
}

QComboBox {
  background-color: #111827;
  border: 1px solid #1F2937;
  border-radius: 8px;
  padding: 6px 10px;
  color: #F9FAFB;
}

QComboBox::drop-down {
  border: none;
}

QMenuBar {
  background-color: #111827;
  color: #F9FAFB;
  border-bottom: 1px solid #1F2937;
}

QMenu {
  background-color: #111827;
  border: 1px solid #1F2937;
  border-radius: 8px;
  padding: 4px;
}

QMenu::item:selected {
  background-color: #1F2937;
  border-radius: 6px;
}

QToolTip {
  background-color: #111827;
  color: #F9FAFB;
  border: 1px solid #1F2937;
  border-radius: 6px;
  padding: 4px 8px;
}

QTabBar::tab {
  background-color: #111827;
  color: #9CA3AF;
  padding: 8px 16px;
  border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
  color: #3B82F6;
  border-bottom-color: #3B82F6;
}

QStatusBar {
  background-color: #111827;
  color: #9CA3AF;
  border-top: 1px solid #1F2937;
}
